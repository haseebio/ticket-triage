{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Ticket Triage color tokens. Primitive values below are direct from the brand spec; semantic tokens are what components should reference.",

  "primitive": {
    "coral": { "500": { "$type": "color", "$value": "#FF6B4A" } },
    "yellow": { "500": { "$type": "color", "$value": "#FFC93C" } },
    "white": { "$type": "color", "$value": "#FFFFFF" },
    "cream": { "$type": "color", "$value": "#FFF9F3" },
    "beige": { "$type": "color", "$value": "#F8F5F2" },
    "gray": {
      "200": { "$type": "color", "$value": "#E5E7EB" },
      "500": { "$type": "color", "$value": "#6B7280" },
      "800": { "$type": "color", "$value": "#1F2937" }
    },
    "green": { "600": { "$type": "color", "$value": "#2E9E6D", "$description": "Not in brand spec — added for status semantics (resolved)" } },
    "red": { "500": { "$type": "color", "$value": "#D9534F", "$description": "Not in brand spec — added for status semantics (failed/quota)" } }
  },

  "semantic": {
    "surface": {
      "page": { "$type": "color", "$value": "{primitive.white}" },
      "card": { "$type": "color", "$value": "{primitive.cream}" },
      "section": { "$type": "color", "$value": "{primitive.beige}" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "{primitive.gray.800}" },
      "secondary": { "$type": "color", "$value": "{primitive.gray.500}" },
      "on-action": { "$type": "color", "$value": "{primitive.white}" }
    },
    "border": {
      "default": { "$type": "color", "$value": "{primitive.gray.200}" },
      "focus": { "$type": "color", "$value": "{primitive.coral.500}" }
    },
    "action": {
      "primary": { "$type": "color", "$value": "{primitive.coral.500}" },
      "primary-soft": { "$type": "color", "$value": "#FFEAE3" },
      "secondary": { "$type": "color", "$value": "{primitive.yellow.500}" }
    },
    "feedback": {
      "success": { "$type": "color", "$value": "{primitive.green.600}" },
      "error": { "$type": "color", "$value": "{primitive.red.500}" }
    },
    "effect": {
      "hover-gradient": { "$type": "color", "$value": "linear-gradient(135deg, #FF6B4A 0%, #FFC93C 100%)" },
      "glass-bg": { "$type": "color", "$value": "rgba(255, 255, 255, 0.65)" },
      "glass-blur": { "$type": "dimension", "$value": "20px" }
    }
  },

  "$darkMode": {
    "$description": "Not populated yet — brand spec was light-mode only. Per standing default, dark mode should resolve every semantic token above before this is considered done."
  }
}
